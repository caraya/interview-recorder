{
  "name": "interview-recorder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs server/config.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "test:integration": "node --env-file-if-exists=.env --test tests/database.integration.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "lucide-react": "^0.468.0",
    "ws": "^8.18.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "concurrently": "^9.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "drizzle-kit": "^0.31.0"
  }
}
